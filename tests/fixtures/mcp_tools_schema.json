  {
    "description": "Find films whose plot matches a description. Use this first for any 'which movie is it' question.\n\nReturns up to top_k distinct films, best match first, each with movie_id, title, release_year, director, genre,\norigin, score, a snippet of the best matching plot passage (at most a few hundred characters) and wiki_url.\nFacts about a film must come from these results (or get_movie); cite every film as 'Title (Year)' plus its\nwiki_url. An empty result means nothing matched: relax the filters or try another mode instead of guessing.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "genre": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only films of exactly this genre (see list_filters for valid values)."
        },
        "mode": {
          "default": "hybrid",
          "description": "'hybrid' (default, best for most questions), 'dense' (meaning only, for vague descriptions) or 'sparse' (keywords only, for names and exact terms).",
          "enum": [
            "dense",
            "sparse",
            "hybrid"
          ],
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only films of exactly this origin/ethnicity (see list_filters for valid values)."
        },
        "query": {
          "description": "Natural-language description of the plot, characters or premise of the film to find.",
          "maxLength": 1000,
          "minLength": 2,
          "type": "string"
        },
        "top_k": {
          "default": 8,
          "description": "How many films to return (best first).",
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "year_from": {
          "anyOf": [
            {
              "type": "integer"
            },
